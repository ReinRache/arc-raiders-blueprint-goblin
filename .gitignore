.venv/
__pycache__/
*.pyc
config.json
supabase_session.json
friends_cache.json
dist/
build/
# credentials.json is no longer written by the app (BYOK removed -- see
# "Steam Web API Proxy" in this file), but a leftover copy from before that
# change may still exist locally on any given machine and must never be
# committed even though nothing creates it anymore.
credentials.json
# Supabase CLI's local cache (project ref, pooler URL, version info) --
# machine-local, regenerated by `supabase link`/`functions deploy`, not
# something to commit.
supabase/.temp/
# arc_companion.spec is hand-crafted and committed (the reproducible build
# config) -- this only excludes an auto-generated spec from a bare
# `pyinstaller main.py` CLI run, which we don't use.
*.spec
!arc_companion.spec
